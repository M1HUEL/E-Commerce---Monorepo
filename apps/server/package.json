  "dependencies": {
    "@ecommerce/db": "workspace:*",
    "@ecommerce/shared": "workspace:*",
    "@nestjs/common": "^11.1.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.7",
    "@nestjs/swagger": "^11.4.7",
    "bcryptjs": "^3.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.4.1",
    "@types/passport-jwt": "^4.0.1",
    "tsc-alias": "^1.9.4",
    "tsconfig-paths": "^4.2.0"
