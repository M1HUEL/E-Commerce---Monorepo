{
  "name": "@ecommerce/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist coverage",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.vitest.json"
  },
  "dependencies": {
    "@prisma/client": "^7.9.1",
    "prisma": "8.0.0-rc.9-dev.75"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.5.1"
  }
}
